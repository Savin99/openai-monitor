[Unit]
Description=Selectel API balance monitor
After=network-online.target
Wants=network-online.target
OnFailure=monitor-alert@%N.service

[Service]
Type=oneshot
WorkingDirectory=/opt/openai_monitor
EnvironmentFile=/etc/default/monitor-telegram
EnvironmentFile=/etc/default/selectel-monitor
Environment=SELECTEL_MONITOR_MODE=api
Environment=SELECTEL_SERVICE_LABEL=Selectel
ExecStart=/usr/bin/python3 /opt/openai_monitor/selectel_monitor.py
