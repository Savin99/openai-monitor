# /etc/default/monitor-telegram
# Общий env-файл для monitor-alert@.service и monitor-watchdog.service.
# НЕ КОММИТИТЬ реальные значения (этот файл — пример). На VPS лежит по пути выше.

TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME

# External liveness pinger (https://healthchecks.io). Optional but recommended:
# protects against full-VPS outages where the watchdog itself can't deliver
# alerts. Watchdog hits the URL on success and <URL>/fail on any problem.
HEALTHCHECKS_URL=https://hc-ping.com/REPLACE_ME-with-real-uuid
